# ─────────────────────────────────────────────────────────────
# MovieFlix 2.0 — variáveis de ambiente
# Copie para .env e preencha. NUNCA comite o .env.
# ─────────────────────────────────────────────────────────────

# ── Supabase (projeto EXISTENTE — preservado) ──
# Project URL e chave pública (anon/publishable). Podem ir ao frontend.
VITE_SUPABASE_URL=https://mntyanfhxiqspdedmddb.supabase.co
VITE_SUPABASE_ANON_KEY=

# Usadas apenas pelo servidor (NUNCA expor no frontend)
SUPABASE_URL=https://mntyanfhxiqspdedmddb.supabase.co
SUPABASE_ANON_KEY=
# Necessária para o painel administrativo verificar is_admin de qualquer usuário.
# Sem ela, /api/admin responde 503. NUNCA coloque esta chave no frontend.
SUPABASE_SERVICE_ROLE_KEY=

# ── TMDB ──
# Chave da API (v3). Fica só no servidor; o navegador nunca a vê.
TMDB_API_KEY=
TMDB_LANG=pt-BR

# ── Servidor ──
PORT=3001
# Origens permitidas no CORS, separadas por vírgula. Vazio = libera todas.
CORS_ORIGINS=

# ── Mercado Pago (Pix automático) ──
# Access Token de PRODUÇÃO (começa com APP_USR-). Só no servidor: nunca no
# frontend, no app Android ou na TV. Sem esta variável o Pix fica desativado
# e a tela de planos volta a oferecer o WhatsApp.
MP_ACCESS_TOKEN=
# Public Key de produção (opcional — só necessária se usar checkout no navegador).
MP_PUBLIC_KEY=
# "Chave secreta" do webhook, mostrada no painel do Mercado Pago ao configurar
# a URL de notificação. Usada para validar a assinatura HMAC.
MP_WEBHOOK_SECRET=
